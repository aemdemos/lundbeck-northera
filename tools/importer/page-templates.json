          "selector": ".isi-mobile-wrap",
          "style": null,
          "blocks": [],
          "defaultContent": [
            ".isi-mobile-wrap .cq-dd-fragment p"
          ]
        },
        {
          "id": "section-5",
          "name": "ISI Full Content",
          "selector": ".cmp-layout-isi__phone",
          "style": "isi",
          "blocks": [],
          "defaultContent": [
            ".cmp-isi__use",
            ".cmp-isi__importantsafety",
            ".cmp-isi__warningbox"
          ]
        }
